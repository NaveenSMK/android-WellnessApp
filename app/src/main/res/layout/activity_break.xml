<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:gravity="center" android:padding="28dp"
    android:background="#FFFFFF" android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:id="@+id/warning" android:textSize="23sp" android:textStyle="bold"
        android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/question" android:textSize="30sp" android:textStyle="bold"
        android:gravity="center" android:paddingTop="30dp" android:paddingBottom="18dp"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/answer" android:inputType="number"
        android:hint="Answer / பதில்" android:textSize="22sp"
        android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/submit" android:text="Continue / தொடர்க"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/result" android:textSize="16sp" android:gravity="center"
        android:paddingTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
