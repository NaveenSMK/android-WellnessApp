<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:padding="24dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="@string/title" android:textSize="28sp"
            android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:text="@string/subtitle" android:textSize="16sp"
            android:paddingTop="8dp" android:paddingBottom="18dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:text="@string/settings_note" android:textSize="16sp"
            android:paddingBottom="20dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/usageButton" android:text="@string/usage_access"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/overlayButton" android:text="@string/overlay_access"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/startButton" android:text="@string/start_monitoring"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/status" android:text="" android:textSize="17sp"
            android:paddingTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
